# ==============================================================================
# MarketMind AI - Production Environment Variables
# "Your AI Marketing Team, Working 24/7."
# ==============================================================================

# Core Application Settings
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173

# PostgreSQL database (use the connection string from your local or hosted PostgreSQL instance)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Security & Multi-Tenant Authentication (Set a strong random key in production!)
JWT_SECRET=marketmind_sec_key_prod_auth_2026_isolated

# ==============================================================================
# AI Engine Configuration
# ==============================================================================
# Supported active Gemini models: gemini-2.5-flash, gemini-2.0-flash, gemini-2.0-flash-lite
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# JSON map of Gemini model names to INR rates per 1M tokens, e.g. {"gemini-2.5-flash":{"input":0,"output":0}}.
# Replace zeroes with the rates applicable to your provider account; live wallet billing requires a non-zero rate.
AI_USAGE_PRICING_INR_PER_MILLION_TOKENS=

# OpenAI API (for GEO, Chat completions, and answer engine evaluation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Perplexity AI API (for Sonar search, citation verification, and GEO visibility)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ==============================================================================
# SEO & Web Performance Real Integrations
# ==============================================================================
# DataForSEO API (Live Google Ads keyword search volume & competition enrichment)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google PageSpeed Insights API (Free from Google Cloud Console)
GOOGLE_PAGESPEED_API_KEY=

# Google Search Console and Google sign-in use a Google Cloud OAuth 2.0 Web client.
# For Google sign-in, add each frontend origin under Authorized JavaScript origins
# (not redirect URIs), e.g. http://localhost:5173 and your production origin.
# GOOGLE_CLIENT_ID must be the same Web client ID configured with those origins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# OpenStreetMap public geocoder/Overpass endpoint overrides (optional).
# Requests are user-triggered and rate-limited; public services have no uptime SLA.
OSM_NOMINATIM_URL=
OSM_OVERPASS_URL=
# Optional contact for the public geocoder's identifying User-Agent.
OSM_CONTACT_EMAIL=

# Google Analytics 4 Measurement Property ID
GA4_PROPERTY_ID=

# Real CMS Auto-Patch Publishing (WordPress REST API Application Password or Webhook)
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
CMS_WEBHOOK_URL=

# ==============================================================================
# Paid Advertising Integrations (Safety: Created strictly in PAUSED status)
# ==============================================================================
# Google Ads API (Requires Google Cloud Project + Developer Token from MCC Manager)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# Meta Marketing API (Requires Meta Developer App with ads_management permission)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=

# ==============================================================================
# Social Media & Multi-Channel Auto-Publishing (Direct API + Webhook Fallback)
# ==============================================================================
# Meta Graph API (Facebook Page & Instagram Business Publishing)
# Meta Facebook Page ID for feed and photo post publishing
META_PAGE_ID=
# Meta Page Access Token with pages_manage_posts and instagram_content_publish permissions
META_PAGE_ACCESS_TOKEN=
# Meta Instagram Business or Creator Account ID
META_IG_USER_ID=
# Meta App Secret for webhook HMAC-SHA256 signature verification
META_APP_SECRET=

# Meta WhatsApp Cloud API Integration
# WhatsApp Cloud API System User Access Token
WHATSAPP_TOKEN=
# WhatsApp Business Phone Number ID
WHATSAPP_PHONE_NUMBER_ID=
# Webhook verification challenge token configured in Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=

# LinkedIn Marketing & Pages API Integration (v2 UGC Posts)
# LinkedIn OAuth 2.0 User Access Token with w_member_social or w_organization_social
LINKEDIN_ACCESS_TOKEN=
# LinkedIn Author URN (e.g. urn:li:person:XXXX or urn:li:organization:XXXX)
LINKEDIN_AUTHOR_URN=

# X (formerly Twitter) API v2 Integration
# X OAuth 2.0 User Context Bearer Token with tweet.write scope
X_ACCESS_TOKEN=

# Webhook URL (Make.com, Zapier, or Buffer webhook fallback for unsynced channels)
SOCIAL_WEBHOOK_URL=

# ==============================================================================
# StartMessaging OTP provider configuration
# ==============================================================================
# Uses the X-API-Key header and POST https://api.startmessaging.com/otp/send.
SMS_PROVIDER=startmessaging
SMS_GATEWAY_URL=https://api.startmessaging.com/otp/send
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_APP_NAME=AddonAIx

# ==============================================================================
# Razorpay Payment Gateway Integration
# ==============================================================================
# Razorpay Key ID for processing subscription payments
RAZORPAY_KEY_ID=
# Razorpay Key Secret for checkout HMAC signature verification
RAZORPAY_KEY_SECRET=
# Razorpay Webhook Secret for incoming event verification
RAZORPAY_WEBHOOK_SECRET=
# Exchange rate from USD to INR for subscription billing (default: 85)
USD_INR_RATE=

# ==============================================================================
# Resend Transactional Email Integration
# ==============================================================================
# Resend API key for sending branded transactional emails
RESEND_API_KEY=
# Verify your sending domain in Resend before sending to arbitrary user addresses.
# Set this to a sender on that verified domain (e.g. Addon AI <welcome@yourdomain.com>).
EMAIL_FROM=

# ==============================================================================
# S3 / Cloudflare R2 Persistent Object Storage
# ==============================================================================
# S3 compatible endpoint URL (e.g. https://<account_id>.r2.cloudflarestorage.com)
S3_ENDPOINT=
# S3 region (defaults to auto for Cloudflare R2)
S3_REGION=auto
# S3 Access Key ID
S3_KEY=
# S3 Secret Access Key
S3_SECRET=
# S3 Bucket Name
S3_BUCKET=
# S3 Public CDN URL prefix for asset delivery (e.g. https://pub-xxx.r2.dev)
S3_PUBLIC_URL=

# ==============================================================================
# Sentry Error Telemetry & Exception Tracking
# ==============================================================================
# Sentry Data Source Name (DSN) for capturing unhandled runtime exceptions
SENTRY_DSN=
